// jinn:introspect@0.3.0 (M2-K10, harness #32; 0.2.0 M2-K9, #31; 0.1.0
// M2-K7, #19) — the read-only composition
// contract. The kernel supplies it (01 §Mechanical closure); a plugin sees
// the composition only when its profile entry grants this contract. Every
// read crosses the broker (grant check → ledger append → dispatch) and is
// answered from a SNAPSHOT of kernel-owned state — no guest is called on
// this path (R1). Reached over `services.resolve("jinn:introspect")` +
// `services.call(handle, <operation>, [])`; answers are the UTF-8 JSON of
// the records below, field names as written (kebab-case).
package jinn:introspect@0.3.0;

interface composition {
  // The kernel registrations one live seat holds, by class.
  record registrations { listeners: u32, alarms: u32, sockets: u32, processes: u32 }

  // One profile entry as the kernel runs it. `fiber`, `state`, and
  // `incarnation` are absent for an entry with no live fiber (disabled,
  // faulted, or a group). `state` is the fiber's last committed state
  // (`pending` | `loading` | `active` | `failed` | `unloading` |
  // `disposed`); `incarnation` identifies the CURRENT activation — never
  // reused within a kernel process, so a restart is evidenced by the same
  // fiber under a new incarnation.
  // `unserved` (0.2.0) names what this entry's LIVE incarnation already
  // owes, when it owes anything: the kernel has taken a target the current
  // incarnation cannot serve and has not yet landed it. In exactly that
  // window a reply-expecting `events.emit` selecting one of this entry's
  // listeners is REFUSED with the matching `kernel-error` case, and asking
  // here is how a caller learns that without discovering it by stalling.
  // Absent for an entry that can serve, and for one with no installed
  // incarnation (arriving, torn down, disabled, or a group).
  // What a live incarnation already owes, and therefore what a caller
  // refused by it must do next (0.2.0). The four are different futures,
  // so they are four answers: only `restarting` promises a replacement,
  // and it is answered only where the kernel can genuinely schedule one.
  enum unserved {
    // A replacement is scheduled: retry once the restart lands.
    restarting,
    // Disposal is owed, and disposal is terminal: never retry.
    gone,
    // Suspension is owed: retry after a resume, which may never come.
    suspended,
    // A change nothing will schedule from here is owed: a dependency has
    // been withdrawn, a failure is not retried against an unchanged
    // environment (R9), or the fiber is terminal. Never retry blindly —
    // watch for the environment to move.
    stalled,
  }

  record entry {
    id: string,
    fiber: option<u64>,
    state: option<string>,
    incarnation: option<u64>,
    unserved: option<unserved>,
    provisions: list<string>,
    registrations: registrations,
  }

  // One LIVE wait: `waiter` is parked on `target` until the crossing
  // named by `on` settles, and cannot answer anything else meanwhile
  // (0.3.0). This is the graph the kernel refuses a cycle-closing
  // crossing against, read from the same source, so an operator asking
  // "why was that refused?" and the refusal itself never disagree.
  // Edges exist only while somebody is actually parked: this is a
  // snapshot of now, never a history. A `waits` answer therefore differs
  // between two reads of an otherwise identical composition.
  record wait {
    // The fiber parked, and the entry it serves when one is named.
    waiter: u64,
    waiter-entry: option<string>,
    // The fiber it is parked on, and that fiber's entry.
    target: u64,
    target-entry: option<string>,
    // What is being waited on: "contract.operation" for a contract call,
    // the topic for a dispatch.
    on: string,
  }

  // The daemon's readiness: the boot reconcile has landed, and the
  // profile/artifact watcher is armed (the machine-readable shape of the
  // readiness line, harness #12).
  record readiness { boot-reconciled: bool, watcher-armed: bool }

  // Effect class: read. Operation `entries`, empty payload; answer = the
  // JSON list of `entry`, in document order.
  entries: func() -> list<entry>;

  // Effect class: read. Operation `readiness`, empty payload; answer = the
  // JSON `readiness` record.
  readiness: func() -> readiness;

  // Effect class: read. Operation `waits`, empty payload; answer = the
  // JSON list of `wait`, in the order the waits were taken. A crossing
  // whose target already appears, transitively, as a waiter on the
  // caller is the cycle the kernel refuses. (0.3.0)
  waits: func() -> list<wait>;
}

world introspect-provider {
  export composition;
}
