// jinn:introspect@0.6.0 (M2-K24, harness #7/#45/#46; 0.5.0 M2-K16; 0.4.0
// M2-K13, harness #40/#41; 0.3.0 M2-K10, #32; 0.2.0 M2-K9, #31; 0.1.0 M2-K7,
// #19) — the read-only composition contract. The kernel supplies it (01 §Mechanical closure); a plugin sees
// the composition only when its profile entry grants this contract. Every
// read crosses the broker (grant check → ledger append → dispatch) and is
// answered from a SNAPSHOT of kernel-owned state — no guest is called on
// this path (R1). Reached over `services.resolve("jinn:introspect")` +
// `services.call(handle, <operation>, [])`; answers are the UTF-8 JSON of
// the records below, field names as written (kebab-case).
// 0.5.0 (2026-09-02, M2-K16) is the FIRST PARSEABLE edition: 0.4.0 never
// parsed (`from` is a WIT keyword; `record readiness` collided with the
// `readiness` operation). The wire operation `readiness` and its answer
// shape are unchanged; the record is `readiness-report` (README, R12).
// 0.6.0 (2026-09-03, M2-K24) is additive: `entry` gains `injects` and
// `unmet`, so an operator reading a `pending` entry is told WHY it has not
// activated instead of inferring it (Law 2).
package jinn:introspect@0.6.0;

interface composition {
  // The kernel registrations one live seat holds, by class.
  record registrations { listeners: u32, alarms: u32, sockets: u32, processes: u32 }

  // One profile entry as the kernel runs it. `fiber`, `state`, and
  // `incarnation` are absent for an entry with no live fiber (disabled,
  // faulted, or a group). `state` is the fiber's last committed state
  // (`pending` | `loading` | `active` | `failed` | `unloading` |
  // `disposed`); `incarnation` identifies the CURRENT activation — never
  // reused within a kernel process, so a restart is evidenced by the same
  // fiber under a new incarnation.
  // `unserved` (0.2.0) names what this entry's LIVE incarnation already
  // owes, when it owes anything: the kernel has taken a target the current
  // incarnation cannot serve and has not yet landed it. In exactly that
  // window a reply-expecting `events.emit` selecting one of this entry's
  // listeners is REFUSED with the matching `kernel-error` case, and asking
  // here is how a caller learns that without discovering it by stalling.
  // Absent for an entry that can serve, and for one with no installed
  // incarnation (arriving, torn down, disabled, or a group).
  // What a live incarnation already owes, and therefore what a caller
  // refused by it must do next (0.2.0). The four are different futures,
  // so they are four answers: only `restarting` promises a replacement,
  // and it is answered only where the kernel can genuinely schedule one.
  enum unserved {
    // A replacement is scheduled: retry once the restart lands.
    restarting,
    // Disposal is owed, and disposal is terminal: never retry.
    gone,
    // Suspension is owed: retry after a resume, which may never come.
    suspended,
    // A change nothing will schedule from here is owed: a dependency has
    // been withdrawn, a failure is not retried against an unchanged
    // environment (R9), or the fiber is terminal. Never retry blindly —
    // watch for the environment to move.
    stalled,
  }

  // `injects` (0.6.0) is the entry's string-lane dependency declaration:
  // the contracts its profile entry declares it injects at activation, in
  // declaration order, exactly as the document of record writes them (a
  // disabled entry's included) — empty for an entry that declares
  // nothing. A declared consumer's fiber rests `pending` until
  // every declared provider is `active`, reloads when one is replaced,
  // and re-arms from `failed` when one moves (the typed lane's epoch
  // gating, carried to the string lane; SOURCE-OF-TRUTH §3).
  // `unmet` (0.6.0) names which declared contracts the kernel's gate
  // currently finds unmet — no live provider, or a provider not yet
  // `active` — in declaration order; empty when every declared provider
  // is `active`, and always empty for an entry that declares nothing. A
  // `pending` entry with a non-empty `unmet` is waiting on exactly those,
  // and two entries that declare each other show each other's contract
  // here for the daemon's life: the recorded limit, cleanly inactive (I3).
  // A declaration the entry holds no grant for is not unmet: it is a
  // per-entry fault refused on the record at admission, and the entry
  // rests `failed` with the refusal in its ledger row.
  record entry {
    id: string,
    fiber: option<u64>,
    state: option<string>,
    incarnation: option<u64>,
    unserved: option<unserved>,
    injects: list<string>,
    unmet: list<string>,
    provisions: list<string>,
    registrations: registrations,
  }

  // One LIVE wait: `waiter` is parked on `target` until the crossing
  // named by `on` settles, and cannot answer anything else meanwhile
  // (0.3.0). This is the graph the kernel refuses a cycle-closing
  // crossing against, read from the same source, so an operator asking
  // "why was that refused?" and the refusal itself never disagree.
  // Edges exist only while somebody is actually parked: this is a
  // snapshot of now, never a history. A `waits` answer therefore differs
  // between two reads of an otherwise identical composition.
  record wait {
    // The fiber parked, and the entry it serves when one is named.
    waiter: u64,
    waiter-entry: option<string>,
    // The fiber it is parked on, and that fiber's entry.
    target: u64,
    target-entry: option<string>,
    // What is being waited on: "contract.operation" for a contract call,
    // the topic for a dispatch.
    on: string,
  }

  // The daemon's readiness: the boot reconcile has landed, and the
  // profile/artifact watcher is armed (the machine-readable shape of the
  // readiness line, harness #12).
  record readiness-report { boot-reconciled: bool, watcher-armed: bool }

  // ONE COMMITTED FIBER TRANSITION, PUSHED (0.4.0). The kernel publishes
  // every transition it commits on the RESERVED topic
  // `jinn:introspect/transitions`, as the UTF-8 JSON of this record. A
  // holder of this contract's grant SUBSCRIBES with the plugin world's
  // `events.listen` on that topic and receives deliveries as
  // `lifecycle.handle-event`; nothing else may write there — a guest
  // `events.emit` on the reserved topic is REFUSED, so a witnessed
  // transition can never be confused with a forged one.
  //
  // WHY IT EXISTS. `entries` answers from a snapshot, so a consumer can
  // only ever see a fiber at REST. Three of the states this contract's own
  // `state` field names — `unloading`, `pending`, `loading` — sit between
  // two rests and no poller reaches them. A catalog built on the pull
  // therefore announces transitions it did not witness and cannot time.
  // This delivery is what it witnesses instead.
  //
  // ORDERING AGAINST THE LEDGER. A delivery NEVER precedes its ledger row.
  // `committed-by` is a ledger sequence the kernel had already committed
  // through when this delivery began, and the transition's own row sits at
  // or before it. A listener holding `jinn:ledger` can check that itself
  // rather than take it on trust.
  //
  // BACK-PRESSURE, AND WHAT A SLOW SUBSCRIBER COSTS. The kernel never
  // waits on a listener, and neither does any other listener: every
  // subscriber has a delivery queue of its own, and the kernel hands its
  // payload over without ever joining. A listener that dawdles inside
  // `handle-event` therefore delays NOBODY — not the kernel, not a
  // sibling, and not a sibling's next transition. It pays for its own
  // slowness alone: once its own queue is full it LOSES transitions, and
  // every loss is counted twice — as a `PublishDropped` ledger event, and
  // as a gap in the `ordinal` this listener receives. Nothing is ever
  // reordered: one subscriber's deliveries follow the order the kernel
  // committed them in, whatever its siblings are doing.
  //
  // LATE JOIN AND REPLAY. There is NO replay, and a late joiner is told so
  // rather than left to assume otherwise: `ordinal` counts every
  // transition this kernel process has published, so a first delivery
  // above 1 states exactly how many preceded the subscription. A listener
  // holding `jinn:ledger` recovers them from the stream itself.
  //
  // AUTHORITY. Every field here is one this contract's own pull already
  // admits: `entry`, `fiber` and `incarnation` are `entry`'s fields, and
  // `from`/`to` are values of `entry.state`'s vocabulary. The kernel's
  // `cause` for a transition is DELIBERATELY ABSENT: nothing in this
  // contract answers WHY a transition happened, so delivering it would
  // widen the grant rather than push what it already admits. A consumer
  // that needs the cause holds `jinn:ledger` and reads the row.
  record transition {
    // The profile entry, exactly as `entry.id` names it.
    entry: string,
    // The fiber, exactly as `entry.fiber` names it.
    fiber: u64,
    // The entry's live incarnation as the kernel saw it when the
    // transition was committed; absent when no incarnation was installed.
    incarnation: option<u64>,
    // The states, from `entry.state`'s vocabulary.
    %from: string,
    to: string,
    // This kernel process's publish count, from 1. Gaps are losses; a
    // first value above 1 is a late join. Never reused, never reordered.
    ordinal: u64,
    // A ledger sequence already committed when this delivery began; the
    // transition's own row is at or before it.
    committed-by: u64,
  }

  // Effect class: read. Operation `entries`, empty payload; answer = the
  // JSON list of `entry`, in document order.
  entries: func() -> list<entry>;

  // Effect class: read. Operation `readiness`, empty payload; answer = the
  // JSON `readiness-report` record.
  readiness: func() -> readiness-report;

  // Effect class: read. Operation `waits`, empty payload; answer = the
  // JSON list of `wait`, in the order the waits were taken. A crossing
  // whose target already appears, transitively, as a waiter on the
  // caller is the cycle the kernel refuses. (0.3.0)
  waits: func() -> list<wait>;
}

world introspect-provider {
  export composition;
}
