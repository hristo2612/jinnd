/// jinn:plugin@0.4.0 — the Tier A plugin world (M1-P8; constitution 01, R7, R12).
///
/// This file is the product: it is designed to outlive any particular kernel
/// implementation or host OS (R12). Versioned; within a major version every
/// change is strictly additive. 0.2.0 (M2-K3): the `fs` import is finalized
/// to its contract bundle (`contracts/jinn-fs`, 0.2.0) — the bundle's
/// `fs-error` and `idempotency-key` now cross the guest boundary verbatim.
/// 0.3.0 (M2-K4): lifecycle semantics — suspend ≠ dispose. No signature
/// changes; the guest-visible meaning of `activate`/`undo` under shutdown
/// and incarnation replacement is now contract (see `lifecycle`), mirrored
/// in every bundle's metadata under `contracts/`. 0.4.0 (M2-K6): the
/// `process` and `net` imports gain their long-lived editions — additive
/// over 0.3.0 (`run` and `request` unchanged in shape) and bound to the
/// contract bundles `contracts/jinn-process` and `contracts/jinn-net`,
/// whose `process-error` / `net-error` cross the guest boundary verbatim.
/// A 0.x minor is semver's compatibility boundary (cargo's own reading);
/// the only 0.1.0 guests are the in-tree fixtures and the harness, which
/// adopts through its pin-bump procedure.
///
/// Law 1: everything is a plugin behind a typed capability contract; there is
/// no other way for a plugin to affect the world. A Tier A component's only
/// imports are the kernel surfaces below. Authority over real contracts
/// (jinn:fs, jinn:ledger, ...) is held as GRANTS: the broker refuses `resolve`
/// for a contract the plugin was not granted, so no handle exists and no call
/// can be made — mechanical closure at the single dispatch point (decision log
/// 2026-08-25: grant check → ledger append → dispatch, transport-agnostic).
/// Law 2: every crossing of these surfaces is a ledger event.
package jinn:plugin@0.4.0;

/// Shared vocabulary of the plugin world (R3: typed, not stringly — the
/// stringly lanes here are the declared dynamic-plugin lane, never the
/// primary API surface).
interface types {
  /// Stable identity of one reversible effect at the kernel boundary.
  type effect-id = u64;

  /// A resolved capability handle: pairs a granted contract with the caller's
  /// scope (R4). Handles are minted by the broker and are not forgeable or
  /// transferable across instances.
  type handle-id = u64;

  /// Stable error classes exposed by the kernel boundary. Guest panics and
  /// traps never cross it (R11); they surface to SIBLINGS only as declared
  /// dependency failures.
  variant kernel-error {
    /// The calling instance's context is no longer active.
    inactive-context,
    /// The named contract has no active provider in the caller's realm.
    missing-dependency(string),
    /// The grant check refused this call; every refusal is a ledger event
    /// (constitution 01 §Grants).
    grant-refused(string),
    /// The provider failed while answering; contained per R11.
    provider-failed(string),
    /// The kernel refused the operation as malformed.
    invalid(string),
  }

  /// The five dispatch modes of the one event bus (LAW §3).
  enum dispatch-mode { emit, parallel, serial, bail, waterfall }

  /// Declarative listener selector (decision log 2026-08-25, C4 binding):
  /// closures cannot cross the component boundary, so the payload's routing
  /// choice is DATA; realm queries are evaluated kernel-side. Routing stays
  /// inverted (LAW §3): the payload selects listeners, listeners never filter
  /// the payload.
  variant selector {
    /// Every registered listener of the topic.
    all,
    /// Listeners whose registration context is in this set.
    context-set(list<u64>),
    /// Listeners whose registration context resolves the named service in
    /// the same realm the emitter's context resolves it (evaluated by the
    /// kernel against the isolation map).
    realm-of(string),
  }
}

/// Reversible-effect registration (Law 3, R5: the one mutation primitive).
/// A guest registers its inverse at the point of action; teardown replays
/// inverses in reverse order (LIFO). Instance disposal withdraws exactly the
/// instance's contribution and nothing else (I1).
interface effects {
  use types.{effect-id, kernel-error};

  /// Registers one reversible effect charged to the calling fiber. `token`
  /// names the guest-side inverse: on withdrawal the host calls
  /// `lifecycle.undo(token)` — exactly once — before the effect is gone.
  /// The registration itself is a ledger event (Law 2).
  register: func(label: string, token: u64) -> result<effect-id, kernel-error>;
}

/// Service provision and injection over the capability broker (R7).
/// Every operation here crosses the single broker dispatch point:
/// grant check → ledger append → dispatch. Whether the peer answering is a
/// linked component instance or a sandboxed process is a transport detail.
interface services {
  use types.{effect-id, handle-id, kernel-error};

  /// Provides the named contract from this instance's fiber, in the realm the
  /// fiber's context resolves it. Provision is an effect (R5): it is
  /// withdrawn with the fiber (I2), and a second provider for an occupied
  /// slot is refused — replacement is never silent (R9).
  provide: func(contract: string) -> result<effect-id, kernel-error>;

  /// Resolves a granted contract to a caller-scoped handle (R4). Refused
  /// without a grant (constitution 01: a plugin may call only the contracts
  /// it was granted); refusals are ledger events.
  resolve: func(contract: string) -> result<handle-id, kernel-error>;

  /// Calls one operation on a resolved handle. The payload is the contract's
  /// serialized request (the contract bundle in `contracts/` governs its
  /// schema, effect class, and equality semantics); the ledger records the
  /// crossing, never a copy of data-plane traffic beyond the contract-level
  /// record (decision log 2026-08-25).
  call: func(handle: handle-id, operation: string, payload: list<u8>)
    -> result<list<u8>, kernel-error>;
}

/// The one event bus (LAW §3), five dispatch modes, inverted routing.
interface events {
  use types.{effect-id, kernel-error, dispatch-mode, selector};

  /// Emits one typed payload under the declared mode. `target` is the
  /// payload's declarative listener selection (C4). Outputs are the settled
  /// listener answers per mode; a failing listener never aborts a collecting
  /// walk (R9) — its failure is contained and recorded.
  emit: func(topic: string, mode: dispatch-mode, target: selector, payload: list<u8>)
    -> result<list<list<u8>>, kernel-error>;

  /// Registers this instance as a listener of `topic`. Registration is just
  /// an effect (LAW §3); withdrawal is `lifecycle.undo` like any other.
  /// Deliveries arrive as `lifecycle.handle-event(token, ...)`.
  listen: func(topic: string, token: u64) -> result<effect-id, kernel-error>;
}

/// Base host-provider contract `jinn:fs` (R7): the kernel supplies this
/// import; authority over it is a GRANT. Every call crosses the broker's
/// single dispatch point under the contract name `jinn:fs` — grant check →
/// ledger append → dispatch to the contract's live provider — so an
/// ungranted call is refused and the refusal is a ledger event (Law 1
/// mechanical closure; constitution 01 §Grants). This interface IS the
/// contract bundle `contracts/jinn-fs` (0.2.0) as seen from the guest:
/// same operations, same `fs-error`, same idempotency keys (R12 — the
/// bundle is the product; this file binds it into the world). A grant may
/// carry a `path-prefix` scope: every operation is authorized against the
/// caller's granted subtree on the FULLY RESOLVED path (after symlink
/// resolution; an unresolvable path is refused) — a path beside the scope
/// answers `denied`, on the record (M2-K3).
interface fs {
  /// One directory entry or stat answer (contract bundle `file-meta`).
  /// Broker wire (M2-K3): u32-LE length of the path's UTF-8 bytes, the
  /// path bytes, u64-LE size, u64-LE modified-ms (unix ms), one is-dir
  /// byte; a `list` answer is these records back to back.
  record file-meta { path: string, size: u64, modified-ms: u64, is-dir: bool }

  /// The bundle's error, verbatim: `not-found` is the TYPED absence answer
  /// of every read and of `remove` (callers classify by case, never by
  /// folding a message); `denied` is a grant or scope refusal (a ledger
  /// event); `io` carries every other contained failure — the provider's
  /// own, or the kernel boundary's (no live provider, inactive context).
  variant fs-error { not-found, denied, io(string) }

  /// Reads one file. Effect class: read.
  /// Broker wire: operation `read`, payload = the path's UTF-8 bytes.
  read: func(path: string) -> result<list<u8>, fs-error>;

  /// Lists one directory's entries (names relative to it, sorted). Effect
  /// class: read.
  /// Broker wire: operation `list`, payload = the path's UTF-8 bytes.
  %list: func(path: string) -> result<list<file-meta>, fs-error>;

  /// Describes one path. Effect class: read.
  /// Broker wire: operation `meta`, payload = the path's UTF-8 bytes.
  meta: func(path: string) -> result<file-meta, fs-error>;

  /// Writes one file. Effect class: revertible — the provider registers the
  /// inverse (constitution 03): restore prior content or absence. The
  /// forward operation runs under keyed exactly-once semantics (03 §Act):
  /// a repeated delivery of the same non-empty `idempotency-key` from the
  /// same fiber answers the recorded effect without applying the mutation
  /// again; an empty key claims no idempotency. The registered effect
  /// joins the calling fiber's journal: teardown withdraws it LIFO with the
  /// rest of the fiber's contribution (R5, I1).
  /// Broker wire: operation `write`, payload = u32-LE length + path bytes,
  /// u32-LE length + key bytes, then the data; answer = the 8-byte LE
  /// effect id.
  write: func(path: string, bytes: list<u8>, idempotency-key: string)
    -> result<_, fs-error>;

  /// Appends to one file, creating it. Effect class: revertible — inverse
  /// = truncate to the prior length, or restore prior absence (the shape
  /// for guest-kept logs). Keyed and journaled as `write`.
  /// Broker wire: operation `append`, payload and answer as `write`.
  append: func(path: string, bytes: list<u8>, idempotency-key: string)
    -> result<_, fs-error>;

  /// Removes one file. Effect class: revertible — inverse = restore the
  /// prior content. A missing path answers `not-found` and registers no
  /// effect. Keyed and journaled as `write`.
  /// Broker wire: operation `remove`, payload = u32-LE length + path
  /// bytes, u32-LE length + key bytes; answer as `write`.
  remove: func(path: string, idempotency-key: string) -> result<_, fs-error>;
}

/// Base host-provider contract `jinn:process` (R7; M2-K6 long-lived
/// edition, contract bundle `contracts/jinn-process` 0.1.0). Same grant
/// discipline and broker choke point as `fs`. A grant carries a typed
/// `process-policy` scope — an executable allowlist by canonical path
/// prefix plus an environment policy — enforced per call on the FULLY
/// RESOLVED executable (post-symlink); a bare grant allows nothing
/// (default deny). A spawned process is a KERNEL REGISTRATION (lifecycle
/// class): killed and ledgered on suspend and on dispose alike, never
/// retained — a plugin re-spawns in `activate`. Every host call here is
/// non-blocking or bounded (R1): reads answer `would-block`, `wait` is
/// capped at 1000ms, the guest polls (a `jinn:clock` alarm is the wake
/// shape in v0.1; see the bundle README).
interface process {
  /// The bundle's own error, verbatim (R3, R12; round 4): `not-found` is
  /// an unknown or foreign handle, `denied` a ledgered grant refusal,
  /// `invalid` a malformed request, `failed` every contained failure —
  /// the provider's own or the kernel boundary's — and `output-truncated`
  /// is `run` past the bundle's `output-cap-bytes`, matched by case.
  variant process-error { not-found, denied(string), failed(string), invalid(string), output-truncated }

  /// The caller-scoped identity of one spawned child (R4: minted for the
  /// spawning instance; a handle used by another peer is refused).
  type process-handle = u64;

  /// A child's output stream.
  enum child-stream { stdout, stderr }

  /// One non-blocking read: bytes now, nothing yet, or the stream's end.
  variant read-result { data(list<u8>), would-block, eof }

  /// One bounded wait: the exit status (a signal termination is the
  /// negated signal number), or still running at the cap.
  variant wait-result { exited(s32), running }

  /// The signals a guest may deliver.
  enum signal { interrupt, terminate, kill }

  /// Runs one command to completion (bounded at the guest deadline's
  /// order; the child is killed at the bound and reaped on the record),
  /// answering its stdout bytes — collected through a bounded buffer
  /// under the bundle's `output-cap-bytes`; past it the call fails typed
  /// `output-truncated` (R9), never a silent prefix.
  /// Effect class: kernel registration, released by completion.
  /// Broker wire: operation `run`, payload = for the command and then each
  /// argument, a u32-LE byte length followed by the UTF-8 bytes; answer =
  /// one tag byte (0 data then the bytes, 3 output-truncated).
  run: func(command: string, args: list<string>) -> result<list<u8>, process-error>;

  /// Spawns one long-lived child with piped stdin/stdout/stderr. `command`
  /// is an absolute path; `env` are the child's explicit variables — the
  /// grant's env policy decides what else it inherits. Effect class:
  /// kernel registration (killed on suspend/dispose, ledgered).
  /// Broker wire: operation `spawn`, payload = u32-LE argc, u32-LE envc,
  /// then u32-LE-length-prefixed segments: command, cwd (empty = none),
  /// the args, and each env name and value; answer = 8-byte LE handle.
  spawn: func(command: string, args: list<string>, cwd: option<string>,
    env: list<tuple<string, string>>) -> result<process-handle, process-error>;

  /// Offers bytes to the child's stdin without blocking; answers how many
  /// were accepted (re-offer the rest). Broker wire: operation
  /// `write-stdin`, payload = 8-byte LE handle then the bytes; answer =
  /// u32-LE accepted count.
  write-stdin: func(handle: process-handle, bytes: list<u8>) -> result<u32, process-error>;

  /// Closes the child's stdin (its EOF). Broker wire: operation
  /// `close-stdin`, payload = 8-byte LE handle.
  close-stdin: func(handle: process-handle) -> result<_, process-error>;

  /// Takes up to `max` buffered bytes of one stream. The host pumps each
  /// stream into a BOUNDED buffer: a guest that never reads applies
  /// backpressure to the child, never unbounded host memory (R9).
  /// Broker wire: operation `read`, payload = 8-byte LE handle, one
  /// stream byte (0 stdout, 1 stderr), u32-LE max; answer = one tag byte
  /// (0 data, 1 would-block, 2 eof) then the data.
  read: func(handle: process-handle, which: child-stream, max: u32)
    -> result<read-result, process-error>;

  /// Waits up to `timeout-ms` (capped at 1000) for the child's exit.
  /// Broker wire: operation `wait`, payload = 8-byte LE handle, u64-LE
  /// timeout; answer = one tag byte (0 exited, 1 running) then i32-LE.
  wait: func(handle: process-handle, timeout-ms: u64) -> result<wait-result, process-error>;

  /// Delivers one signal; the exit lands as a ledger event when the host
  /// reaps the child. Broker wire: operation `kill`, payload = 8-byte LE
  /// handle then one signal byte (0 interrupt, 1 terminate, 2 kill).
  kill: func(handle: process-handle, signal: signal) -> result<_, process-error>;
}

/// Base host-provider contract `jinn:net` (R7; M2-K6 server edition,
/// contract bundle `contracts/jinn-net` 0.1.0). Same grant discipline and
/// broker choke point as `fs`. A grant carries a typed `net-policy`
/// scope — a bind port range (loopback only in v0.1) and an outbound host
/// allowlist; a bare grant allows nothing (default deny). Listeners and
/// connections are KERNEL REGISTRATIONS: closed on suspend and on
/// dispose, ledgered; a plugin re-listens in `activate`. Every call is
/// non-blocking (R1): `accept` and `read` answer `would-block`, `write`
/// answers what the socket accepted.
interface net {
  /// The bundle's own error, verbatim (R3, R12; round 4): `not-found` is
  /// an unknown or foreign handle, `denied` a ledgered grant refusal,
  /// `invalid` a malformed request or address, `failed` every contained
  /// failure — the provider's own or the kernel boundary's.
  variant net-error { not-found, denied(string), failed(string), invalid(string) }

  /// A caller-scoped listener or connection identity (R4).
  type net-handle = u64;

  /// One non-blocking accept.
  variant accept-result { connection(net-handle), would-block }

  /// One non-blocking read: bytes now, nothing yet, or the peer's close.
  variant read-result { data(list<u8>), would-block, eof }

  /// Performs one request, answering the response body. NOT PROVIDED in
  /// v0.1 (the kernel carries no HTTP client, R10): the provider answers a
  /// typed `failed`; the outbound allowlist scope is admitted
  /// for the edition that consumes it (see the bundle README).
  /// Broker wire: operation `request`, payload = u32-LE length + method
  /// bytes, u32-LE length + url bytes, then the body.
  request: func(method: string, url: string, body: list<u8>) -> result<list<u8>, net-error>;

  /// Binds one loopback listener at `addr` (`ip:port`); a non-loopback
  /// address or a port outside the granted range is refused on the
  /// record. Effect class: kernel registration. Broker wire: operation
  /// `listen`, payload = the address's UTF-8 bytes; answer = 8-byte LE
  /// handle.
  listen: func(addr: string) -> result<net-handle, net-error>;

  /// Takes one pending connection, if any. The connection is a kernel
  /// registration of its own. Broker wire: operation `accept`, payload =
  /// 8-byte LE listener; answer = one tag byte (0 connection, 1
  /// would-block) then the 8-byte LE connection handle.
  accept: func(listener: net-handle) -> result<accept-result, net-error>;

  /// Reads up to `max` bytes now available. Broker wire: operation
  /// `read`, payload = 8-byte LE connection, u32-LE max; answer = one tag
  /// byte (0 data, 1 would-block, 2 eof) then the data.
  read: func(connection: net-handle, max: u32) -> result<read-result, net-error>;

  /// Writes what the socket accepts now; answers the count (re-offer the
  /// rest). Broker wire: operation `write`, payload = 8-byte LE
  /// connection then the bytes; answer = u32-LE count.
  write: func(connection: net-handle, bytes: list<u8>) -> result<u32, net-error>;

  /// Closes one listener or connection — the registration's release,
  /// ledgered. Broker wire: operation `close`, payload = 8-byte LE handle.
  close: func(handle: net-handle) -> result<_, net-error>;
}

/// Host capability contract `jinn:clock` (M2-K2; contract bundle
/// `contracts/jinn-clock`). Time enters the system honestly: reads cross
/// the broker's choke point, and every wake is a ledger event (Law 2).
///
/// An alarm request IS an effect (R5): the kernel registers its
/// cancellation as the undo, teardown cancels it with the rest of the
/// instance's contribution (LIFO), and a Mode-1 swap carries live alarms
/// through the seat's staged outcome exactly like any registration (R8).
/// Alarms do NOT survive a kernel restart in v0.1: a plugin re-requests
/// its alarms in `activate` — that is the honest contract, not a defect.
///
/// Resolution is scoped (R9: no free high-frequency wake hazard): a
/// periodic alarm finer than the granted floor is refused. The kernel's
/// default floor is 250ms (the contract bundle documents it).
interface clock {
  use types.{effect-id, kernel-error};

  /// Reads the host clock: milliseconds since the Unix epoch. A plain
  /// instant — v0.1 defines no civil-time (timezone/DST) semantics; the
  /// ledger's sequence, never this clock, carries ordering authority.
  /// Effect class: read. Broker wire: operation `now`, empty payload,
  /// answer = 8-byte little-endian milliseconds.
  now: func() -> result<u64, kernel-error>;

  /// Requests one wake at `instant-ms` (the `now` domain). An instant
  /// already past wakes once, immediately. Delivery:
  /// `lifecycle.handle-event(token, "jinn:clock/alarm", payload)` with
  /// payload = 8-byte little-endian wake instant. Effect class:
  /// revertible — the undo cancels the alarm.
  alarm-at: func(instant-ms: u64, token: u64) -> result<effect-id, kernel-error>;

  /// Requests a wake every `period-ms`, first wake one period from now,
  /// delivered as `alarm-at` describes. Refused below the granted
  /// resolution floor. Effect class: revertible — the undo cancels.
  alarm-every: func(period-ms: u64, token: u64) -> result<effect-id, kernel-error>;
}

/// Base host-provider contract `jinn:keystore` (R7). Same grant discipline
/// and broker choke point as `fs`. Sensitivity class: secret
/// (constitution 02 §Redaction — values never land in the ledger).
interface keystore {
  use types.{kernel-error};

  /// Reads one secret. Broker wire: operation `get`, payload = key bytes.
  get: func(key: string) -> result<list<u8>, kernel-error>;

  /// Stores one secret. Effect class: revertible.
  /// Broker wire: operation `put`, payload = u32-LE length + key bytes,
  /// then the value.
  put: func(key: string, value: list<u8>) -> result<_, kernel-error>;
}

/// The lifecycle surface every Tier A plugin exports. A plugin body runs once
/// per fiber (LAW §3 "Fiber"); the host instantiates one component instance
/// per fiber and disposes it instantly and completely on teardown (R7, I1).
interface lifecycle {
  /// A contained guest failure. It deactivates the guest's own fiber and its
  /// declared dependents, cleanly, and touches nothing else (R11).
  variant guest-fault {
    failed(string),
  }

  /// The plugin body: runs exactly once per fiber, receiving the entry's
  /// serialized config (constitution 04). Effects registered here are the
  /// fiber's contribution; they are withdrawn LIFO on teardown (I1).
  ///
  /// Suspend ≠ dispose (M2-K4, decision log 2026-08-28): a contribution
  /// belongs to the profile ENTRY. Only the entry's removal from the
  /// composition withdraws it. A kernel shutdown, or an incarnation
  /// replacement (config edit, dependency change, hot-swap), SUSPENDS the
  /// instance instead: kernel registrations — provisions, listeners,
  /// alarms — release and are re-established by the next `activate`;
  /// host-provider effects (`jinn:fs` writes) are retained for the entry
  /// and its next incarnation inherits them, revertible by key, withdrawn
  /// LIFO at the entry's eventual dispose. A guest-side inverse (`undo`)
  /// is instance-bound: it runs on withdrawal, never on suspension.
  /// Once the instance's journal seals for withdrawal or suspension, every
  /// further registration is refused (`inactive-context`, ledgered).
  activate: func(config: list<u8>) -> result<_, guest-fault>;

  /// Per-consumer vitality check (decision log 2026-08-25, C3 binding): the
  /// kernel evaluates provider checks per consumer, per notify — `consumer`
  /// identifies the asking fiber, and the provider answers for that consumer
  /// specifically. A trap here reads as `false` and is contained (R11).
  check: func(consumer: u64) -> bool;

  /// Runs the inverse registered under `token` (effects.register /
  /// events.listen). Called exactly once per withdrawal, in LIFO order
  /// (Law 3). A trap is recorded as an unclean withdrawal, never retried
  /// silently (R9).
  undo: func(token: u64) -> result<_, guest-fault>;

  /// Delivers one selected event to the listener registered under `token`.
  handle-event: func(token: u64, topic: string, payload: list<u8>)
    -> result<list<u8>, guest-fault>;

  /// Answers one contract call dispatched to this instance as a provider
  /// (services.provide). The broker has already grant-checked and ledgered
  /// the crossing on the caller's side; `caller` is the calling peer's
  /// identity (R4) — a handle pairs the implementation with the caller's
  /// scope, so the provider always knows who is calling.
  handle-call: func(caller: u64, contract: string, operation: string, payload: list<u8>)
    -> result<list<u8>, guest-fault>;

  /// Mode-1 hot-swap state handoff, old instance side (R8): an optional
  /// opaque blob the retiring instance offers its successor. Empty means
  /// nothing to hand off.
  snapshot: func() -> list<u8>;

  /// Mode-1 hot-swap state handoff, new instance side (R8): offered the old
  /// instance's blob after its own `activate` succeeded. Refusing the blob
  /// fails the swap's health gate and rolls back to the old instance.
  restore: func(blob: list<u8>) -> result<_, guest-fault>;
}

/// The Tier A plugin world (R7): logic and orchestration plugins and ALL
/// machine-written code, first-party included. Imports are exactly the kernel
/// surfaces plus the base host-provider contracts the kernel supplies
/// (fs, process, net, keystore); capability authority arrives only as grants
/// checked at the broker (constitution 01 §Mechanical closure) — the linker
/// binds every import for every component, but every call through one is
/// refused without its grant, and every refusal is a ledger event.
world plugin {
  import effects;
  import services;
  import events;
  import fs;
  import process;
  import net;
  import keystore;
  import clock;

  export lifecycle;
}
